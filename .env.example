# Copy file này thành .env rồi sửa giá trị.
DEBUG=True
SECRET_KEY=thay-bang-chuoi-ngau-nhien-dai
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL 8 (CSDL chính). Tạo database + user theo README trước.
DATABASE_URL=mysql://calories:matkhau@localhost:3306/calories
# SQLite (không cần cài gì, dùng để thử nhanh): bỏ comment dòng dưới, comment dòng trên
# DATABASE_URL=sqlite:///db.sqlite3

# MySQL trên cloud (Aiven...): dán nguyên Service URI, giữ phần ?ssl-mode=REQUIRED ở cuối
# DATABASE_URL=mysql://avnadmin:matkhau@ten-service.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# Chỉ dùng khi deploy (lệnh prepare_deploy, xem README): link tải file .zip chứa thư mục model, tài khoản admin
# MODEL_URL=https://.../model.zip
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=dat-mat-khau-o-day

# Thiết bị chạy model trên web: cpu | cuda | auto
ML_DEVICE=cpu
# Số giây giữa 2 lần kiểm tra model active trong CSDL (hot-reload)
MODEL_CHECK_INTERVAL=10
# Cứ mỗi N giờ web tự xoá ảnh trong media/ không còn được CSDL tham chiếu (0 = tắt, Dockerfile đặt sẵn 6)
UPLOAD_CLEANUP_HOURS=0
