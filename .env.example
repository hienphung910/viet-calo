# Copy file này thành .env rồi sửa giá trị.
DEBUG=True
SECRET_KEY=thay-bang-chuoi-ngau-nhien-dai
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL 8 (CSDL chính). Tạo database + user theo README trước.
DATABASE_URL=mysql://calories:matkhau@localhost:3306/calories
# SQLite (không cần cài gì, dùng để thử nhanh): bỏ comment dòng dưới, comment dòng trên
# DATABASE_URL=sqlite:///db.sqlite3

# Ngưỡng tin cậy của top-1 (0..1)
CONFIDENCE_THRESHOLD=0.6

# Thiết bị chạy model trên web: cpu | cuda | auto
ML_DEVICE=cpu
# Số giây giữa 2 lần kiểm tra model active trong CSDL (hot-reload)
MODEL_CHECK_INTERVAL=10
